# Shared variables and requests, imported by examples/imports.http.
# It can be run on its own too:
#   axon-cli -f examples/shared/common.http -n uuid

import headers.http

@host = httpbin.org
@base = https://{{host}}
@version = v1
# Built from @base and @version: a file that imports this one and sets
# either of them changes @api too (the last definition wins everywhere).
@api = {{base}}/anything/{{version}}

### uuid
# A request other files can depend on, like a login. httpbin returns
#   {"uuid": "..."}
# @assert status == 200
# @assert {{response.body.$.uuid}} exists
GET {{base}}/uuid
Accept: {{accept}}
