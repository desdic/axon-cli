# Example requests against https://httpbin.org, which echoes what it receives.
#
#   axon-cli -f examples/httpbin.http                        # list requests
#   axon-cli -f examples/httpbin.http -l                     # list names only
#   axon-cli -f examples/httpbin.http -n get                 # run one
#   axon-cli -f examples/httpbin.http -n "set cookie" -n "read cookies"
#   axon-cli -f examples/httpbin.http -n "csrf form"          # runs "login" first, uses its cookies
#   axon-cli -f examples/httpbin.http -n "show upload"        # runs "upload" first, filters its values
#   axon-cli -f examples/httpbin.http -n "basic auth" --netrc-file examples/netrc
#   axon-cli -f examples/httpbin.http -n "show item"         # runs "create item" first
#   axon-cli -f examples/httpbin.http -n "each slide"        # runs "slides" first, then once per slide
#   axon-cli -f examples/httpbin.http -n "team members"      # nested loops: each member of each team
#   axon-cli -f examples/httpbin.http -n "slide x team"      # every slide with every team
#   axon-cli -f examples/httpbin.http -n "member details"    # loops over each "team details" response
#   axon-cli -f examples/httpbin.http -n "checked slides"    # @let, @skip-if and checks
#   axon-cli -f examples/httpbin.http -n "file token"        # {{$file}} in a variable and a header
#   axon-cli -f examples/httpbin.http -n "file body"         # request body read from a file
#   axon-cli -f examples/httpbin.http -n "each id"           # loops over the lines of a file
#   axon-cli -f examples/httpbin.http -n "each user role"    # loops over a JSON file, nested
#   axon-cli -f examples/httpbin.http -n teapot --strict     # checks and exit codes
#   HTTPBIN_TOKEN=s3cret axon-cli -f examples/httpbin.http -n bearer
#   axon-cli -f examples/httpbin.http -n environment -b | jq .headers

@host = httpbin.org
@base = https://{{host}}
@user = demo
# A file variable can read the environment; it is only needed (and checked)
# when a request that uses it runs.
@token = {{$env HTTPBIN_TOKEN}}
# {{$file PATH}} reads a file, relative to this one, without trailing newlines.
@file_token = {{$file data/token.txt}}
# Filters work in file variables too; this one is only evaluated (and
# "upload" only sent) when a request that uses {{item_id}} runs.
@item_id = {{upload.response.headers.Location | split("/", -1) | split("?", 0)}}

### get
GET {{base}}/get?source=axon-cli
Accept: application/json

### create item
POST {{base}}/post
Content-Type: application/json
X-Trace: {{$env USER}}

{
  "name": "widget",
  "owner": "{{user}}"
}

### show item
# Chaining: uses values from the "create item" response, so that request runs
# first (once) when it has not run yet. httpbin echoes the posted JSON as "json".
GET {{base}}/anything/{{create item.response.body.$.json.name}}
Accept: {{create item.response.headers.Content-Type}}

### slides
# httpbin's sample JSON: {"slideshow": {"slides": [{"title": ..., "type": ...}, ...]}}
GET {{base}}/json

### each slide
# Loops: runs once for each element of the array, with {{slide}} as the element.
# @foreach slide in {{slides.response.body.$.slideshow.slides}}
GET {{base}}/anything/slides/{{slide.type}}
X-Slide-Title: {{slide.title}}

### teams
# httpbin echoes the posted JSON back as "json", so this gives lists to loop over.
POST {{base}}/anything/teams
Content-Type: application/json

{"teams": [{"name": "core", "members": ["ann", "bob"]}, {"name": "web", "members": ["eve"]}]}

### team members
# Nested loops: several @foreach lines nest, the first outermost. A later one
# can loop over a value inside an earlier loop variable: ann, bob, then eve.
# @foreach team in {{teams.response.body.$.json.teams}}
# @foreach member in {{team.members}}
GET {{base}}/anything/teams/{{team.name}}/{{member}}

### slide x team
# Nested loops over two different responses: every slide with every team
# (2 slides x 2 teams = 4 requests). With --json, each iteration has
# "loop": {"slide": 0, "team": 1}.
# @foreach slide in {{slides.response.body.$.slideshow.slides}}
# @foreach team in {{teams.response.body.$.json.teams}}
GET {{base}}/anything/{{slide.type}}/{{team.name}}

### team details
# @foreach team in {{teams.response.body.$.json.teams}}
POST {{base}}/anything/teams/{{team.name}}
Content-Type: application/json

{"members": {{team.members}}}

### member details
# Following a loop: this references the looping "team details", so it runs
# once per iteration of it, reading that iteration's response, with {{team}}
# still that iteration's team. Its own @foreach then loops over the members
# in that response.
# @foreach member in {{team details.response.body.$.json.members}}
GET {{base}}/anything/teams/{{team.name}}/members/{{member}}

### checked slides
# `@let` defines a variable for this request only, evaluated per iteration.
# `@skip-if` skips the iterations where its check is true, like `continue`:
# the first slide ("Wake up to WonderWidgets!") is not sent.
# Checks then run on each response sent:
#   `@assert`  fails the run (exit 1)      `@fail-if`    the same, when true
#   `@warn`    reported, exit 0 (exit 1    `@warn-if`    the same, when true
#              with --strict)
#   `@notice`  reported, never fails       `@notice-if`  the same, when true
# (A comment line starting with "# @let", "# @assert", ... is a directive.)
# @foreach slide in {{slides.response.body.$.slideshow.slides}}
# @let kind = {{slide.type}}-{{slide.title | split(" ", 0)}}
# @skip-if {{slide.title}} contains "Wake"
# @assert status in 200, 201
# @assert {{response.body.$.headers['X-Kind']}} == "{{kind}}"
# @warn {{response.headers.Content-Type}} contains "json"
# @notice-if {{slide.items}} !exists
GET {{base}}/anything/slides/{{slide.type}}
X-Kind: {{kind}}

### bearer
# Token from the environment, through @token:
#   HTTPBIN_TOKEN=s3cret axon-cli -f examples/httpbin.http -n bearer
# Without HTTPBIN_TOKEN set, this fails before anything is sent.
GET {{base}}/bearer
Authorization: Bearer {{token}}

### environment
# {{$env NAME}} works directly in the URL, headers and body too.
POST {{base}}/anything/{{$env USER}}
X-Lang: {{$env LANG}}
Content-Type: application/json

{"user": "{{$env USER}}", "terminal": "{{$env TERM}}"}

### file token
# The token comes from data/token.txt through @file_token; {{$file ...}} also
# works directly in the URL, headers and body, with filters.
GET {{base}}/bearer
Authorization: Bearer {{file_token}}
X-Token-Prefix: {{$file data/token.txt | split("-", 0)}}

### file body
# The whole body from a file; httpbin echoes it back as "json".
POST {{base}}/anything/items
Content-Type: application/json

{{$file data/item.json}}

### each id
# Loops over a file: one iteration per line of data/ids.txt (101, 102, 103),
# skipping blank lines and # comments. Nothing is sent if the file is missing.
# @foreach id in {{$file data/ids.txt}}
GET {{base}}/anything/items/{{id}}

### each user role
# A .json file must hold an array; its elements can be objects, and a second
# loop can go over a value inside them: ann/admin, ann/dev, bob/dev.
# (The loop variable is "person", since @user is already a file variable.)
# @foreach person in {{$file data/users.json}}
# @foreach role in {{person.roles}}
GET {{base}}/anything/users/{{person.name}}/roles/{{role}}

### Update (renamed below)
# @name update item
PUT {{base}}/put HTTP/1.1
Content-Type: text/plain

plain text body

### delete
// URL-only lines default to GET, so the method is spelled out here.
delete {{base}}/delete

### basic auth
# Credentials come from netrc: run with --netrc-file examples/netrc.
GET {{base}}/basic-auth/{{user}}/s3cret

### set cookie
# Redirects to /cookies; add --no-follow to see the 302 itself.
GET {{base}}/cookies/set?flavor=oatmeal

### read cookies
# Run after "set cookie" in the same invocation to see the cookie sent back.
GET {{base}}/cookies

### login
# A login that sets two cookies: a CSRF token and an HttpOnly session.
# (httpbin's /response-headers returns whatever headers the query asks for.)
GET {{base}}/response-headers?Set-Cookie=csrftoken%3Dx7k2p9%3B%20Path%3D%2F&Set-Cookie=session%3Dabc123%3B%20HttpOnly

### csrf form
# Cookie chaining: {{login.response.cookies.NAME}} is the cookie's value only,
# without attributes, so "login" runs first. Both cookies are also sent back
# automatically in the Cookie header, since they are in the same run; the
# CSRF token is copied into a header and the body as well.
POST {{base}}/anything/form
X-CSRF-Token: {{login.response.cookies.csrftoken}}
Content-Type: application/json

{"csrf": "{{login.response.cookies.csrftoken}}", "session": "{{login.response.cookies.session}}"}

### session path
# Cookie values work in the URL too. Only cookies on the final response can be
# referenced: "set cookie" sets its cookie on a redirect, so
# {{set cookie.response.cookies.flavor}} only works with --no-follow.
GET {{base}}/anything/session/{{login.response.cookies.session}}

### upload
# Returns a Location header and echoes it, plus two values, as JSON:
#   Location: /api/v2/items/42?rev=7
#   {"Location": "/api/v2/items/42?rev=7", "X-File": "report-2026-11.json",
#    "X-Token": " Bearer t0k3n ", ...}
GET {{base}}/response-headers?Location=%2Fapi%2Fv2%2Fitems%2F42%3Frev%3D7&X-Token=%20Bearer%20t0k3n%20&X-File=report-2026-11.json

### show upload
# Filters take parts of a value with "|", applied left to right:
#   split("sep", N)  part N after splitting on sep (0-based, -1 is the last)
#   trim             strip leading and trailing whitespace
#   prefix("x")      remove x from the start (an error if it is not there)
#   suffix("x")      remove x from the end (an error if it is not there)
# Here: item 42 (via @item_id), revision 7, token "t0k3n", month "2026-11".
GET {{base}}/anything/items/{{item_id}}?rev={{upload.response.headers.Location | split("rev=", 1)}}
Authorization: Bearer {{upload.response.body.$['X-Token'] | trim | prefix("Bearer ")}}
X-Month: {{upload.response.body.$['X-File'] | suffix(".json") | prefix("report-")}}
X-Year: {{upload.response.body.$['X-File'] | split("-", 1)}}

### redirect
GET {{base}}/redirect/2

### teapot
# 4xx/5xx still exit 0 unless a check fails. This one passes, and prints
#   NOTICE request "teapot": if status == 418: matched "418"
# and with --strict it also fails the @warn (exit 1).
# @assert status in 200, 418
# @notice-if status == 418
# @warn status < 400
GET {{base}}/status/418

### html
GET {{base}}/html

### binary
# Non-UTF-8 bodies come back base64-encoded.
GET {{base}}/bytes/16
